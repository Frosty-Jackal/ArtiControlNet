# 复制为 .env 后填入真实密钥（.env 已被 gitignore）
# 各变量含义见 Spec §7.4

# DeepSeek（路由 + QA）
DEEPSEEK_API_KEY=your_deepseek_api_key
OPENAI_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-flash
VLM_MODEL=deepseek-v4-flash-vision-exp

# TokenHub 统一生图（文生图 + 线稿生图，hy-image-v3）
TOKENHUB_API_KEY=your_tokenhub_api_key
# 以下三项可选，默认值见 config.py
# TOKENHUB_API_URL=https://tokenhub.tencentmaas.com/v1/wand/hunyuan-image/v3-generation
# HUNYUAN_IMAGE_MODEL=hy-image-v3
# HUNYUAN_IMAGE_SIZE=1024x1024

# 服务
CORS_ALLOW_ORIGINS=http://localhost:5173
MAIN_SERVER_HOST=0.0.0.0
MAIN_SERVER_PORT=8000

# 认证（Spec2）
# JWT 签名密钥：随机长串，只放 .env，绝不入库 / 不进代码
JWT_SECRET=please_change_to_a_long_random_string
JWT_EXPIRE_SECONDS=604800
# 首次启动自动创建的初始管理员（仅 users 表为空时使用；建号后即可改）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please_change_this_password

# 社区 / 分享 / 建议（Spec9，可选）
# 分享链接有效期（秒，默认 604800 = 7 天）
# SHARE_TTL_SECONDS=604800

# 个人作品风格 Wiki（Spec12，可选；默认值见 config.py）
# WIKI_STYLE_MAX=2000          # 手编 / 生成的风格文本上限（字）
# WIKI_PROMPT_ITEM_MAX=500     # 单条作品 prompt 提取上限（字）
# WIKI_PROMPT_TOTAL_MAX=6000   # 一次合并送入 LLM 的参考文字总上限（字）

# 上传作品纳入风格（Spec15，可选；默认值见 config.py）
# WIKI_UPLOAD_QA_MAX=10           # 单次刷新最多分析的上传图张数
# WIKI_UPLOAD_QA_CONCURRENCY=3    # 视觉 QA 并发路数
# WIKI_UPLOAD_ANSWER_MAX=300      # 单条上传图分析结果的截断上限（字）
# WIKI_UPLOAD_QA_MAX_SIDE=1024    # 送模型前缩放的最长边（px）

# 社区评论（Spec17，可选；默认值见 config.py）
# COMMENT_TEXT_MAX=200          # 单条评论字数上限（与前端 CommunityPanel.vue 同值，改要一起改）

# 对话历史（Spec17，可选；默认值见 config.py）
# CONVERSATION_LIST_LIMIT=50    # 侧边栏一次返回的对话条数上限（不分页）

# ---- 服务限额（Spec18，均可留空用默认值）----
# 注意 QUOTA_DEFAULT_LIMIT 的作用域：它只在「新建用户」与「补列迁移给存量行填初值」
# 两处生效，改它**不会**影响任何已存在的用户。要给某个已有账号加额度，走管理端的
# 「用户管理」页 → 该用户那行的「改限额」。
# QUOTA_DEFAULT_LIMIT=10               # 新用户的免费试用额度（累计次数）。Spec23 起
                                       # 它就是"新注册送几次"。只影响新建账号。
# QUOTA_LIMIT_MAX=100000               # 管理员可设的限额上限（防误输入天文数字）
# 超额提示语现在指向登录页的「充值面板」，正文里不再带邮箱，所以没有
# QUOTA_CONTACT_EMAIL 这个变量了（曾经有，只用来拼那句话）。

# ---- 注册申请与审批（Spec19，均可留空用默认值）----
# SUPPORT_EMAIL=frostyj@qq.com          # 客服邮箱（超额提示与注册页共用）
# REGISTER_ENABLED=true                 # 置 false 关闭注册入口
# Spec22 删除：REGISTER_IP_WINDOW_SECONDS —— "同一 IP 24 小时一次"的注册冷却已随
#   需求 3 整个去掉（防重改由邮箱验证码承担）。设了也不生效的变量留在这里，
#   只会让人以为它还在起作用。
# 收款码：把微信收款码图片放到 Server/payment.jpg（该文件不进仓库）

# ---- 注册申请邮件通知（Spec20，全部可留空）----
# 不配 SMTP_PASSWORD 就完全不发信，注册行为与之前一模一样。
# SMTP_PASSWORD 是 QQ 邮箱的「授权码」，不是 QQ 登录密码。
# 生成方式（新版界面）：mail.qq.com → 右上角头像 →「账号与安全」→「安全设置」
#                        →「POP3/IMAP/SMTP/...服务」→ 生成授权码。
# 只完整显示一次；丢了在「设备管理 / 授权码管理」里重置，旧码随即失效。
# SMTP_HOST=smtp.qq.com                 # 默认 smtp.qq.com
# SMTP_PORT=465                         # 465 = SSL（不是 587 STARTTLS）
# SMTP_USER=frostyj@qq.com              # 发件账号（默认跟随 SUPPORT_EMAIL）
# SMTP_PASSWORD=                        # 授权码；留空 = 关闭通知
# REGISTER_NOTIFY_TO=frostyj@qq.com     # 收件人（默认跟随 SUPPORT_EMAIL）
# SMTP_TIMEOUT_SECONDS=10               # SMTP 超时（秒）

# ---- 余额与充值（Spec21，全部可留空/可省）----
# 充值提醒邮件的收件人。默认跟随 SUPPORT_EMAIL，单个变量是为了将来能分开。
# 发信机制与 Spec20 完全共用：唯一的开关仍是 SMTP_PASSWORD（留空 = 完全不发信）。
# RECHARGE_NOTIFY_TO=frostyj@qq.com
# RECHARGE_WECHAT_MAX=64
# 同一用户提交充值申请的冷却期（秒，默认 180 = 3 分钟）。冷却期内的重复提交
# 返回 40905，前端跳出的那句告警里的分钟数由这个值推出来，改秒数文案会跟着变。
# RECHARGE_COOLDOWN_SECONDS=180

# ---- 邮箱验证码与入口统计（Spec22，全部可留空用默认值）----
# ⚠️ 本功能**依赖 SMTP_PASSWORD**：不配它时注册、邮箱登录、修改密码三条链路全部
#    不可用（接口返回 50302「邮箱服务暂不可用」）。这与 Spec20/21 的"邮件只是通知"
#    性质不同——那两次不配 SMTP 只是不发信，业务照常。
# 发码与验码的失败共用 Spec2 的登录限速（同 IP 5 次 / 5 分钟 → 42901），无需配置。
# EMAIL_CODE_TTL_SECONDS=600         # 验证码有效期（秒）= 10 分钟
# EMAIL_CODE_RESEND_SECONDS=60       # 同一邮箱 + 同一场景的重发冷却（秒）= 1 分钟
#                                    # 上面两句的分钟数会同步出现在邮件正文与告警文案里
